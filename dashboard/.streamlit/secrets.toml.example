# Copy this file to .streamlit/secrets.toml for LOCAL testing only, or paste
# its contents (with your real values) into Streamlit Community Cloud's
# "Settings -> Secrets" UI when you deploy - never commit real credentials.
#
# .streamlit/secrets.toml is already listed in the project's .gitignore.
#
# If you already have `aws configure`'d credentials locally with access to
# the healthcare-metrics-gold-941377112484 bucket, you can skip this file
# entirely for local runs - app.py falls back to boto3's default credential
# chain when no [aws] secrets block is present.

[aws]
aws_access_key_id = "YOUR_ACCESS_KEY_ID"
aws_secret_access_key = "YOUR_SECRET_ACCESS_KEY"
region = "us-west-1"
